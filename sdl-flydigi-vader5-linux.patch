+#ifdef SDL_PLATFORM_LINUX
+static bool HIDAPI_DriverFlydigi_IsVader5XpadEvent(const char *event_name, int fd)
+{
+    struct input_id inpid;
+    unsigned long ffbit[NBITS(FF_MAX)] = { 0 };
+    char link_path[PATH_MAX];
+    char link_target[PATH_MAX];
+    ssize_t link_len;
+
+    if (ioctl(fd, EVIOCGID, &inpid) < 0) {
+        return false;
+    }
+    if (inpid.vendor != USB_VENDOR_FLYDIGI_V2 || inpid.product != USB_PRODUCT_FLYDIGI_V2_VADER) {
+        return false;
+    }
+    if (ioctl(fd, EVIOCGBIT(EV_FF, sizeof(ffbit)), ffbit) < 0 || !test_bit(FF_RUMBLE, ffbit)) {
+        return false;
+    }
+
+    (void)SDL_snprintf(link_path, sizeof(link_path), "/sys/class/input/%s/device/device", event_name);
+    link_len = readlink(link_path, link_target, sizeof(link_target) - 1);
+    if (link_len < 0) {
+        return false;
+    }
+    link_target[link_len] = '\0';
+
+    return SDL_strstr(link_target, ":1.0/") != NULL ||
+           (link_len >= 4 && SDL_strcmp(link_target + link_len - 4, ":1.0") == 0);
+}
+
+static void HIDAPI_DriverFlydigi_CloseVader5XpadRumble(SDL_DriverFlydigi_Context *ctx)
+{
+    if (ctx->vader5_xpad_fd >= 0) {
+        close(ctx->vader5_xpad_fd);
+        ctx->vader5_xpad_fd = -1;
+        ctx->vader5_xpad_effect.id = -1;
+    }
+}
+
+static bool HIDAPI_DriverFlydigi_OpenVader5XpadRumble(SDL_DriverFlydigi_Context *ctx)
+{
+    DIR *dir;
+    struct dirent *entry;
+
+    if (ctx->vader5_xpad_fd >= 0) {
+        return true;
+    }
+
+    dir = opendir("/dev/input");
+    if (!dir) {
+        return false;
+    }
+
+    while ((entry = readdir(dir)) != NULL) {
+        char path[PATH_MAX];
+        int fd;
+
+        if (SDL_strncmp(entry->d_name, "event", 5) != 0) {
+            continue;
+        }
+
+        (void)SDL_snprintf(path, sizeof(path), "/dev/input/%s", entry->d_name);
+        fd = open(path, O_RDWR | O_CLOEXEC | O_NONBLOCK, 0);
+        if (fd < 0) {
+            continue;
+        }
+
+        if (HIDAPI_DriverFlydigi_IsVader5XpadEvent(entry->d_name, fd)) {
+            ctx->vader5_xpad_fd = fd;
+            SDL_zero(ctx->vader5_xpad_effect);
+            ctx->vader5_xpad_effect.id = -1;
+            closedir(dir);
+            return true;
+        }
+
+        close(fd);
+    }
+
+    closedir(dir);
+    return false;
+}
+
+static bool HIDAPI_DriverFlydigi_RumbleVader5Xpad(SDL_DriverFlydigi_Context *ctx, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    struct input_event event;
+
+    if (!HIDAPI_DriverFlydigi_OpenVader5XpadRumble(ctx)) {
+        return false;
+    }
+
+    ctx->vader5_xpad_effect.type = FF_RUMBLE;
+    ctx->vader5_xpad_effect.replay.length = SDL_MAX_RUMBLE_DURATION_MS;
+    ctx->vader5_xpad_effect.u.rumble.strong_magnitude = low_frequency_rumble;
+    ctx->vader5_xpad_effect.u.rumble.weak_magnitude = high_frequency_rumble;
+
+    if (ioctl(ctx->vader5_xpad_fd, EVIOCSFF, &ctx->vader5_xpad_effect) < 0) {
+        ctx->vader5_xpad_effect.id = -1;
+        if (ioctl(ctx->vader5_xpad_fd, EVIOCSFF, &ctx->vader5_xpad_effect) < 0) {
+            HIDAPI_DriverFlydigi_CloseVader5XpadRumble(ctx);
+            return false;
+        }
+    }
+
+    SDL_zero(event);
+    event.type = EV_FF;
+    event.code = ctx->vader5_xpad_effect.id;
+    event.value = 1;
+    if (write(ctx->vader5_xpad_fd, &event, sizeof(event)) < 0) {
+        HIDAPI_DriverFlydigi_CloseVader5XpadRumble(ctx);
+        return false;
+    }
+    return true;
+}
